# lo consulta y lo expone con un token de servicio. Sin estas dos variables la pestaña responde 503.
VOXPRO_API_URL=http://200.91.204.51/api
VOXPRO_GESTOR_TOKEN=mismo_valor_que_GESTOR_AWARE_TOKEN_en_voxpro
